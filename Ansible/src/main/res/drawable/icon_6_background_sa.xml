<?xml version="1.0" encoding="utf-8"?>
<!-- Ansible launcher icon background: Vintage — amber neon on dark brown -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#FF3A2413"
                android:endColor="#FF1B1008" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="55%p"
                android:centerX="0.5"
                android:centerY="0.42"
                android:startColor="#66704218"
                android:endColor="#00704218" />
        </shape>
    </item>
</layer-list>
