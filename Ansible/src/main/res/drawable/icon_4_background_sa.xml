<?xml version="1.0" encoding="utf-8"?>
<!-- Ansible launcher icon background: Aqua — teal -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:type="linear"
                android:angle="45"
                android:startColor="#FF0A6C8C"
                android:centerColor="#FF12A6A8"
                android:endColor="#FF48DDB6" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="60%p"
                android:centerX="0.25"
                android:centerY="0.2"
                android:startColor="#40FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
