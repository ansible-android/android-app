<?xml version="1.0" encoding="utf-8"?>
<!-- Ansible launcher icon background: Turbo — hot red -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:type="linear"
                android:angle="45"
                android:startColor="#FFC8104F"
                android:centerColor="#FFF3402F"
                android:endColor="#FFFF9230" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="60%p"
                android:centerX="0.2"
                android:centerY="0.15"
                android:startColor="#33FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
